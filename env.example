# BioLinker Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Core Settings
# =============================================================================

# Debug mode (set to False in production)
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Database
# =============================================================================

# SQLite (development)
DATABASE_URL=sqlite:///./biolinker.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://biolinker:password@localhost:5432/biolinker

# =============================================================================
# Authentication
# =============================================================================

# IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Token expiration (in minutes) - default is 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================================================
# Redis (for background jobs and caching)
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM Configuration
# =============================================================================

# Provider: ollama, openai, or anthropic
LLM_PROVIDER=ollama
LLM_MODEL=ministral-3:3b

# Ollama (local)
LLM_BASE_URL=http://localhost:11434

# OpenAI (if using)
# OPENAI_API_KEY=sk-...

# Anthropic (if using)
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# PubMed API
# =============================================================================

# Optional: NCBI API key for higher rate limits
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI_API_KEY=your-api-key

# Recommended: Your email for NCBI API requests
# NCBI_EMAIL=your-email@example.com

# =============================================================================
# Rate Limits
# =============================================================================

FREE_TIER_SEARCHES=100
FREE_TIER_ARTICLES=500
PRO_TIER_SEARCHES=1000
PRO_TIER_ARTICLES=5000

# =============================================================================
# Feature Flags
# =============================================================================

ENABLE_WAITLIST=True
REQUIRE_EMAIL_VERIFICATION=False

